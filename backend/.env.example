# Copy this file to .env and fill in real TEST-mode values.
# Never commit .env, and never put live/production keys here.

RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Comma-separated list of origins allowed to call this API (your frontend's URL).
ALLOWED_ORIGIN=http://localhost:5173

# Where the hash-chained ledger lives. Defaults to a local SQLite file
# if unset - fine for dev. For the live deployment, point this at a
# free hosted Postgres (Neon, Supabase) so the ledger survives
# restarts/redeploys instead of resetting.
DATABASE_URL=sqlite:///witness_audit.db
